# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ─── Ports ──────────────────────────────────────────────────────────────────
FRONTEND_PORT=5173
BACKEND_PORT=8080
IA_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ─── Frontend ────────────────────────────────────────────────────────────────
# WebSocket and API URLs must be reachable from the browser (host machine).
VITE_BACKEND_WS_URL=ws://localhost:8080/ws/realtime
VITE_API_URL=http://localhost:8080/api
VITE_ENABLE_XR=true

# ─── Backend ─────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
WEBSOCKET_MAX_PAYLOAD_SIZE=512000

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=visaoassistiva
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# ─── AI Service ──────────────────────────────────────────────────────────────
MODEL_PATH=/app/models/yolo26n.pt
CONFIDENCE_THRESHOLD=0.5
MAX_IMAGE_SIZE=512000
# Options: cpu | cuda | mps
DEVICE=cpu
LOG_LEVEL=INFO
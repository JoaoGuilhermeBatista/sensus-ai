{
  "installCommand": "npm install",
  "buildCommand": "cd apps/frontend-xr && npm run build",
  "outputDirectory": "apps/frontend-xr/dist",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=*, microphone=*, xr-spatial-tracking=*, accelerometer=*, gyroscope=*, magnetometer=*"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    }
  ]
}
